# StreamHUB - Environment Variables Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL or SQLite fallback for instant development)
# For MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# For instant zero-setup local dev with SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret Keys
JWT_SECRET="streamhub_luxury_super_secret_key_2026_production"
JWT_REFRESH_SECRET="streamhub_luxury_refresh_secret_key_2026_production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary / Storage for Video & Thumbnail Uploads (Optional, uses local multer storage by default)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Configuration (Nodemailer for OTP & Password Reset)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="noreply@streamhub.com"
EMAIL_PASS="your_app_password_here"

# Redis Configuration (Optional rate limiter & caching)
REDIS_URL="redis://localhost:6379"
